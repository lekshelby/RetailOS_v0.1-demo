# Copy this file to .env.local on the dedicated Windows POS PC. It must remain local.
POSTGRES_USER=retailos
POSTGRES_PASSWORD=SET_A_STRONG_LOCAL_DATABASE_PASSWORD
POSTGRES_DB=retailos
DATABASE_URL=postgresql://retailos:SET_A_STRONG_LOCAL_DATABASE_PASSWORD@localhost:5432/retailos?schema=public
PORT=3000
NODE_ENV=production
# The browser UI and API are served by the same local origin.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_APP_URL=
AUTH_SESSION_SECRET=SET_A_RANDOM_32_BYTE_OR_LONGER_SECRET
AUTH_SESSION_HOURS=12
# Keep accounting sync disabled until the local POS has passed acceptance testing.
BUKKU_AUTO_SYNC_ENABLED=false
BUKKU_BASE_URL=
BUKKU_ACCESS_TOKEN=
BUKKU_COMPANY_SUBDOMAIN=
# Optional direct LAN ESC/POS printing. This reaches only the named printer
# from the API container; do not expose its port publicly.
RETAILOS_THERMAL_PRINTER_HOST=192.168.0.21
RETAILOS_THERMAL_PRINTER_PORT=9100

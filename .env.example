POSTGRES_USER=retailos
POSTGRES_PASSWORD=replace-with-a-strong-password-before-production
POSTGRES_DB=retailos
DATABASE_URL=postgresql://retailos:replace-with-a-strong-password-before-production@localhost:5432/retailos?schema=public
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
AUTH_SESSION_SECRET=replace-with-a-random-32-byte-secret-before-production
AUTH_SESSION_HOURS=12
# Leave blank locally. Set this to the public HTTPS RetailOS address before issuing customer QR codes.
PUBLIC_APP_URL=
BUKKU_BASE_URL=
BUKKU_ACCESS_TOKEN=
BUKKU_COMPANY_SUBDOMAIN=
# Set to false for read-only Bukku inspection scripts. Keep enabled for the running POS service.
BUKKU_AUTO_SYNC_ENABLED=true
# RetailOS PC Print Hub. Phones submit receipts to the API running on this PC.
# Recommended: assign a fixed IP to the LAN ESC/POS printer and use port 9100.
RETAILOS_THERMAL_PRINTER_HOST=
RETAILOS_THERMAL_PRINTER_PORT=9100
# For a PC-paired Bluetooth printer or USB-to-serial device, use its PC COM port.
# This requires the API to run natively on the PC, not in a Docker container.
RETAILOS_THERMAL_PRINTER_SERIAL_PORT=
RETAILOS_THERMAL_PRINTER_SERIAL_BAUD_RATE=9600
# For a Windows-installed USB printer queue, enter the exact Windows queue name.
# This requires the API to run natively on the Windows PC, not in Docker.
RETAILOS_THERMAL_PRINTER_WINDOWS_QUEUE=
# Disabled by default because vendor raster-logo byte streams are a common cause of blank receipts.
RETAILOS_THERMAL_PRINTER_INCLUDE_LOGO=false

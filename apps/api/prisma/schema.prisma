generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum SaleStatus {
  OPEN
  COMPLETED
  VOIDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  DUITNOW
  BANK_TRANSFER
  STORE_CREDIT
  OTHER
}

enum ReturnStatus {
  DRAFT
  COMPLETED
  VOIDED
}

enum ReturnType {
  REFUND
  DISPOSE
  EXCHANGE
}

enum SyncStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

enum SyncDirection {
  INBOUND
  OUTBOUND
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum DiscountScope {
  LINE
  SALE
}

enum EInvoiceRequestStatus {
  PENDING
  PROCESSING
  VALIDATED
  REJECTED
}

enum CashMovementType {
  CASH_IN
  CASH_OUT
}

enum PrintJobStatus {
  QUEUED
  SENDING
  PRINTED
  FAILED
  RETRYING
}

enum InventoryLedgerType {
  SALE
  RETURN
  VOID
  ADJUSTMENT
}

enum InventoryCostStatus {
  FINAL
  PROVISIONAL
  UNVALUED
}

enum InventorySourceType {
  BUKKU_PURCHASE
  STAFF_COUNT
  STAFF_ADJUSTMENT
  POS_SALE
  RETURN
  TRANSFER
  OPENING_BALANCE
}

model Company {
  id String @id @default(cuid())
  name String
  code String @unique
  currency String @default("MYR")
  timezone String @default("Asia/Kuala_Lumpur")
  legalName String?
  registrationNo String?
  tin String?
  brnNew String?
  brnOld String?
  address String?
  officePhone String?
  phone String?
  email String?
  receiptFooter String?
  receiptPaperWidthMm Int @default(80)
  printerConnectionMethod String @default("LAN_ESC_POS")
  printerLanHost String?
  printerLanPort Int @default(9100)
  printerWindowsQueue String?
  printerSerialPort String?
  printerSerialBaudRate Int @default(9600)
  printerProfileName String @default("Main receipt printer")
  printerFallbackMethod String?
  printerFallbackLanHost String?
  printerFallbackLanPort Int?
  receiptTemplate String @default("STANDARD")
  receiptDividerStyle String @default("DASHED")
  receiptShowLogo Boolean @default(false)
  receiptShowSku Boolean @default(false)
  receiptChineseMode String @default("AUTO")
  customerEInvoiceRequestsEnabled Boolean @default(true)
  bukkuDailyInvoiceEnabled Boolean @default(false)
  bukkuDailyInvoiceContactId String?
  bukkuDailyInvoiceLocationId String?
  bukkuDailyInvoiceRevenueAccountId String?
  bukkuDailyInvoiceTaxCodeId String?
  bukkuDailyInvoicePaymentAccounts Json?
  bukkuProductVersion String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  locations Location[]
  users User[]
  products Product[]
  customers Customer[]
  priceLevels PriceLevel[]
  sales Sale[]
  returns Return[]
  eInvoiceRequests EInvoiceRequest[]
  storeCredits StoreCredit[]
  syncJobs SyncJob[]
  auditLogs AuditLog[]
  references ExternalReference[]
  roles Role[]
  printJobs PrintJob[]
  inventoryLedgerEntries InventoryLedgerEntry[]
  batchUpdates BatchUpdate[]
  purchaseReceipts PurchaseReceipt[]
  inventoryBatches InventoryBatch[]
  inventoryBatchEvents InventoryBatchEvent[]
}

model Location {
  id String @id @default(cuid())
  companyId String
  name String
  code String
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  registers Register[]
  stockSnapshots StockSnapshot[]
  shifts Shift[]
  sales Sale[]
  receiptCounters ReceiptCounter[]
  inventoryLedgerEntries InventoryLedgerEntry[]
  batchUpdateRows BatchUpdateRow[]
  purchaseReceipts PurchaseReceipt[]
  inventoryBatches InventoryBatch[]
  @@unique([companyId, code])
}

model Register {
  id String @id @default(cuid())
  locationId String
  name String
  code String
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  sales Sale[]
  shifts Shift[]
  @@unique([locationId, code])
}

model Role {
  id String @id @default(cuid())
  companyId String
  name String
  permissions Json
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users User[]
  @@unique([companyId, name])
}

model User {
  id String @id @default(cuid())
  companyId String
  roleId String
  name String
  email String
  pinHash String?
  status UserStatus @default(ACTIVE)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])
  sales Sale[]
  shifts Shift[]
  auditLogs AuditLog[]
  approvals DiscountOverride[] @relation("DiscountApprover")
  inventoryLedgerEntries InventoryLedgerEntry[]
  inventoryLedgerApprovals InventoryLedgerEntry[] @relation("InventoryLedgerApprover")
  batchUpdatesCreated BatchUpdate[] @relation("BatchCreatedBy")
  batchUpdatesConfirmed BatchUpdate[] @relation("BatchConfirmedBy")
  batchUpdatesApproved BatchUpdate[] @relation("BatchApprovedBy")
  productAliasesCreated ProductAlias[]
  purchaseReceiptsImported PurchaseReceipt[] @relation("PurchaseReceiptImporter")
  purchaseReceiptsApproved PurchaseReceipt[] @relation("PurchaseReceiptApprover")
  inventoryBatchesImported InventoryBatch[] @relation("InventoryBatchImporter")
  inventoryBatchesApproved InventoryBatch[] @relation("InventoryBatchApprover")
  inventoryBatchEvents InventoryBatchEvent[] @relation("InventoryBatchEventActor")
  inventoryBatchEventApprovals InventoryBatchEvent[] @relation("InventoryBatchEventApprover")
  @@unique([companyId, email])
}

model Product {
  id String @id @default(cuid())
  companyId String
  sku String
  name String
  description String?
  supplierDescription String?
  supplierName String?
  lastPurchasedAt DateTime?
  nominalLengthMeters Decimal? @db.Decimal(8, 3)
  basePurchaseCost Decimal? @db.Decimal(14, 2)
  fifoEnabledAt DateTime?
  category String?
  reorderLevel Decimal? @db.Decimal(14, 4)
  classificationCode String?
  bukkuType String?
  bukkuCatalogHash String?
  searchDimensions String[] @default([])
  searchMaterials String[] @default([])
  searchProductTypes String[] @default([])
  active Boolean @default(true)
  deletedAt DateTime?
  trackStock Boolean @default(true)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uoms ProductUOM[]
  barcodes ProductBarcode[]
  prices ProductPrice[]
  purchasePrices ProductPurchasePrice[]
  saleItems SaleItem[]
  returnItems ReturnItem[]
  stockSnapshots StockSnapshot[]
  inventoryLedgerEntries InventoryLedgerEntry[]
  batchUpdateRows BatchUpdateRow[]
  aliases ProductAlias[]
  inventoryBatches InventoryBatch[]
  @@unique([companyId, sku])
  @@index([companyId, name])
  @@index([searchDimensions], type: Gin)
  @@index([searchMaterials], type: Gin)
  @@index([searchProductTypes], type: Gin)
}

model ProductUOM {
  id String @id @default(cuid())
  productId String
  code String
  name String
  conversionFactor Decimal @db.Decimal(12, 4)
  isBase Boolean @default(false)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  barcodes ProductBarcode[]
  prices ProductPrice[]
  purchasePrices ProductPurchasePrice[]
  saleItems SaleItem[]
  returnItems ReturnItem[]
  inventoryLedgerEntries InventoryLedgerEntry[]
  inventoryBatches InventoryBatch[]
  @@unique([productId, code])
}

model ProductBarcode {
  id String @id @default(cuid())
  productId String
  barcode String @unique
  uomId String?
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  uom ProductUOM? @relation(fields: [uomId], references: [id])
}

model PriceLevel {
  id String @id @default(cuid())
  companyId String
  name String
  code String
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  prices ProductPrice[]
  sales Sale[]
  @@unique([companyId, code])
}

model ProductPrice {
  id String @id @default(cuid())
  productId String
  priceLevelId String
  uomId String
  amount Decimal @db.Decimal(14, 2)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceLevel PriceLevel @relation(fields: [priceLevelId], references: [id], onDelete: Cascade)
  uom ProductUOM @relation(fields: [uomId], references: [id])
  @@unique([productId, priceLevelId, uomId])
}

model ProductPurchasePrice {
  id String @id @default(cuid())
  productId String
  uomId String
  amount Decimal @db.Decimal(14, 2)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  uom ProductUOM @relation(fields: [uomId], references: [id], onDelete: Cascade)
  @@unique([productId, uomId])
}

model Customer {
  id String @id @default(cuid())
  companyId String
  contactCode String?
  entityType String @default("MALAYSIAN_COMPANY")
  contactTypes String[] @default(["CUSTOMER"])
  name String
  registrationNoType String?
  registrationNo String?
  oldRegistrationNo String?
  phone String?
  email String?
  taxId String?
  sstRegistrationNo String?
  organization String?
  address String?
  city String?
  state String?
  postcode String?
  countryCode String? @default("MY")
  remarks String?
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sales Sale[]
  returns Return[]
  storeCredits StoreCredit[]
  @@unique([companyId, contactCode])
  @@index([companyId, name])
}

model Sale {
  id String @id @default(cuid())
  companyId String
  locationId String
  registerId String
  cashierId String
  customerId String?
  priceLevelId String
  shiftId String?
  receiptNo String
  status SaleStatus @default(OPEN)
  subtotal Decimal @db.Decimal(14, 2)
  discountTotal Decimal @db.Decimal(14, 2)
  taxTotal Decimal @db.Decimal(14, 2)
  grandTotal Decimal @db.Decimal(14, 2)
  offlineId String?
    deviceId String?
    completedAt DateTime?
  printedAt DateTime?
  eInvoiceRequestToken String? @unique
  receiptSnapshot Json?
    createdAt DateTime @default(now())
  company Company @relation(fields: [companyId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  register Register @relation(fields: [registerId], references: [id])
  cashier User @relation(fields: [cashierId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  priceLevel PriceLevel @relation(fields: [priceLevelId], references: [id])
  shift Shift? @relation(fields: [shiftId], references: [id])
  items SaleItem[]
  payments Payment[]
  discounts DiscountOverride[]
  returns Return[]
  exchangeReplacement Return? @relation("ExchangeReplacementSale")
  eInvoiceRequests EInvoiceRequest[]
  printJobs PrintJob[]
  @@unique([companyId, receiptNo])
  @@unique([companyId, offlineId])
  @@index([companyId, completedAt])
}

enum ProductAliasSource {
  MANUAL
  IMPORT
  GENERATED
}

model ProductAlias {
  id String @id @default(cuid())
  productId String
  text String
  normalizedToken String
  normalizedCompact String
  source ProductAliasSource
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  @@unique([productId, normalizedToken])
  @@index([normalizedToken])
  @@index([normalizedCompact])
  @@index([productId, source])
}

model PrintJob {
  id String @id @default(cuid())
  companyId String
  saleId String?
  shiftId String?
  printerProfile String
  transport String
  status PrintJobStatus @default(QUEUED)
  kind String
  reprint Boolean @default(false)
  attempts Int @default(0)
  lastError String?
  queuedAt DateTime @default(now())
  sendingAt DateTime?
  printedAt DateTime?
  failedAt DateTime?
  createdById String?
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sale Sale? @relation(fields: [saleId], references: [id], onDelete: Cascade)
  @@index([companyId, status, queuedAt])
  @@index([saleId, queuedAt])
}

model EInvoiceRequest {
  id String @id @default(cuid())
  saleId String
  companyId String
  token String @unique
  status EInvoiceRequestStatus @default(PENDING)
  entityType String
  name String
  registrationNoType String?
  registrationNo String?
  tin String?
  phone String?
  email String?
  address String?
  submittedAt DateTime @default(now())
  processedAt DateTime?
  notes String?
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@index([companyId, status, submittedAt])
}

model SaleItem {
  id String @id @default(cuid())
  saleId String
  productId String
  uomId String
  description String
  quantity Decimal @db.Decimal(12, 4)
  baseQuantity Decimal @db.Decimal(14, 4)
  unitPrice Decimal @db.Decimal(14, 2)
  lineDiscount Decimal @db.Decimal(14, 2)
  taxAmount Decimal @db.Decimal(14, 2)
  lineTotal Decimal @db.Decimal(14, 2)
  unitCost Decimal? @db.Decimal(16, 4)
  cogs Decimal? @db.Decimal(16, 4)
  costStatus InventoryCostStatus @default(UNVALUED)
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  uom ProductUOM @relation(fields: [uomId], references: [id])
  discounts DiscountOverride[]
  returns ReturnItem[]
  inventoryLedgerEntries InventoryLedgerEntry[]
  batchAllocations SaleBatchAllocation[]
}

model Payment {
  id String @id @default(cuid())
  saleId String
  method PaymentMethod
  amount Decimal @db.Decimal(14, 2)
  tenderedAmount Decimal @db.Decimal(14, 2)
  changeAmount Decimal @default(0) @db.Decimal(14, 2)
  reference String?
  status PaymentStatus @default(COMPLETED)
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model DiscountOverride {
  id String @id @default(cuid())
  saleId String?
  saleItemId String?
  scope DiscountScope
  type DiscountType
  inputValue Decimal @db.Decimal(14, 4)
  amount Decimal @db.Decimal(14, 2)
  reason String
  approvedById String?
  sale Sale? @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleItem SaleItem? @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("DiscountApprover", fields: [approvedById], references: [id])
}

model Return {
  id String @id @default(cuid())
  saleId String
  companyId String
  customerId String?
  shiftId String?
  replacementSaleId String? @unique
  status ReturnStatus @default(DRAFT)
  type ReturnType @default(REFUND)
  reason String?
  total Decimal @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  sale Sale @relation(fields: [saleId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  shift Shift? @relation(fields: [shiftId], references: [id])
  replacementSale Sale? @relation("ExchangeReplacementSale", fields: [replacementSaleId], references: [id])
  items ReturnItem[]
  payments ReturnPayment[]
  storeCredit StoreCredit?
}

model ReturnItem {
  id String @id @default(cuid())
  returnId String
  saleItemId String?
  productId String
  uomId String
  quantity Decimal @db.Decimal(12, 4)
  baseQuantity Decimal @db.Decimal(14, 4)
  amount Decimal @db.Decimal(14, 2)
  return Return @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem SaleItem? @relation(fields: [saleItemId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  uom ProductUOM @relation(fields: [uomId], references: [id])
  inventoryLedgerEntries InventoryLedgerEntry[]
  batchAllocations SaleBatchAllocation[]
}

model ReturnPayment {
  id String @id @default(cuid())
  returnId String
  method PaymentMethod
  amount Decimal @db.Decimal(14, 2)
  reference String?
  createdAt DateTime @default(now())
  return Return @relation(fields: [returnId], references: [id], onDelete: Cascade)
}

model StoreCredit {
  id String @id @default(cuid())
  companyId String
  customerId String?
  returnId String @unique
  originalAmount Decimal @db.Decimal(14, 2)
  balance Decimal @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  return Return @relation(fields: [returnId], references: [id], onDelete: Cascade)
  @@index([companyId, balance])
}

model Shift {
  id String @id @default(cuid())
  locationId String
  registerId String
  cashierId String
  openedAt DateTime @default(now())
  closedAt DateTime?
  openingFloat Decimal @db.Decimal(14, 2)
  closingFloat Decimal? @db.Decimal(14, 2)
  location Location @relation(fields: [locationId], references: [id])
  register Register @relation(fields: [registerId], references: [id])
  cashier User @relation(fields: [cashierId], references: [id])
  movements CashMovement[]
  sales Sale[]
  processedReturns Return[]
}

model CashMovement {
  id String @id @default(cuid())
  shiftId String
  type CashMovementType
  amount Decimal @db.Decimal(14, 2)
  reason String
  createdAt DateTime @default(now())
  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
}

model StockSnapshot {
  id String @id @default(cuid())
  locationId String
  productId String
  quantity Decimal @db.Decimal(14, 4)
  capturedAt DateTime @default(now())
  location Location @relation(fields: [locationId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  @@unique([locationId, productId])
}

model InventoryLedgerEntry {
  id String @id @default(cuid())
  companyId String
  locationId String
  productId String
  saleItemId String?
  returnItemId String?
  actorId String?
  approvedById String?
  uomId String?
  type InventoryLedgerType
  sourceType InventorySourceType
  quantityDelta Decimal @db.Decimal(14, 4)
  countedQuantity Decimal? @db.Decimal(14, 4)
  beforeQuantity Decimal @db.Decimal(14, 4)
  unitCost Decimal? @db.Decimal(16, 4)
  valueDelta Decimal? @db.Decimal(18, 4)
  runningQuantity Decimal @db.Decimal(14, 4)
  runningValue Decimal? @db.Decimal(18, 4)
  averageUnitCost Decimal? @db.Decimal(16, 4)
  costStatus InventoryCostStatus
  referenceType String
  referenceId String
  reason String?
  batchId String?
  batchRowId String? @unique
  createdAt DateTime @default(now())
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItem SaleItem? @relation(fields: [saleItemId], references: [id], onDelete: SetNull)
  returnItem ReturnItem? @relation(fields: [returnItemId], references: [id], onDelete: SetNull)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  approvedBy User? @relation("InventoryLedgerApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  uom ProductUOM? @relation(fields: [uomId], references: [id], onDelete: SetNull)
  batch BatchUpdate? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  batchRow BatchUpdateRow? @relation(fields: [batchRowId], references: [id], onDelete: SetNull)
  @@unique([referenceType, referenceId, productId])
  @@index([companyId, createdAt])
  @@index([locationId, productId, createdAt])
  @@index([costStatus, createdAt])
  @@index([batchId])
}

model BatchUpdate {
  id String @id
  companyId String
  type String
  checksum String
  fileName String
  mimeType String
  rawFile Bytes
  status String @default("PREVIEWED")
  createdById String
  confirmedById String?
  approvedById String?
  rowCount Int
  validRowCount Int
  invalidRowCount Int
  duplicateRowCount Int
  highRisk Boolean @default(false)
  summary Json?
  createdAt DateTime @default(now())
  committedAt DateTime?
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User @relation("BatchCreatedBy", fields: [createdById], references: [id])
  confirmedBy User? @relation("BatchConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  approvedBy User? @relation("BatchApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rows BatchUpdateRow[]
  ledgerEntries InventoryLedgerEntry[]
  @@unique([companyId, type, checksum])
  @@index([companyId, createdAt])
}

model BatchUpdateRow {
  id String @id
  batchId String
  rowNumber Int
  productId String?
  locationId String?
  input Json
  valid Boolean
  duplicate Boolean @default(false)
  errors String[] @default([])
  beforeQuantity Decimal? @db.Decimal(14, 4)
  requestedQuantity Decimal? @db.Decimal(14, 4)
  afterQuantity Decimal? @db.Decimal(14, 4)
  beforeValue Decimal? @db.Decimal(18, 4)
  afterValue Decimal? @db.Decimal(18, 4)
  costStatus String?
  result Json?
  createdAt DateTime @default(now())
  batch BatchUpdate @relation(fields: [batchId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  ledgerEntry InventoryLedgerEntry?
  @@unique([batchId, rowNumber])
  @@index([productId, locationId])
}

model PurchaseReceipt {
  id String @id
  companyId String
  locationId String
  bukkuReference String
  supplier String
  purchaseDate DateTime @db.Date
  status String @default("DRAFT")
  sourceFileName String?
  batchId String?
  importedById String
  approvedById String?
  negativeStockAcknowledged Boolean @default(false)
  createdAt DateTime @default(now())
  postedAt DateTime?
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id])
  importedBy User @relation("PurchaseReceiptImporter", fields: [importedById], references: [id])
  approvedBy User? @relation("PurchaseReceiptApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  batches InventoryBatch[]
  @@unique([companyId, bukkuReference])
  @@index([companyId, status, createdAt])
}

model InventoryBatch {
  id String @id
  companyId String
  locationId String
  purchaseReceiptId String?
  productId String
  uomId String
  displayBatchId String
  bukkuReference String?
  supplier String?
  receivedQuantity Decimal @db.Decimal(14, 4)
  remainingQuantity Decimal @db.Decimal(14, 4)
  purchaseUnitCost Decimal? @db.Decimal(16, 4)
  landedCostPerUnit Decimal @default(0) @db.Decimal(16, 4)
  finalUnitCost Decimal? @db.Decimal(16, 4)
  totalBatchValue Decimal? @db.Decimal(18, 4)
  billDate DateTime? @db.Date
  receivedAt DateTime
  status String @default("DRAFT")
  sourceType String
  importedById String?
  approvedById String?
  postedAt DateTime?
  voidedAt DateTime?
  createdAt DateTime @default(now())
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id])
  purchaseReceipt PurchaseReceipt? @relation(fields: [purchaseReceiptId], references: [id], onDelete: SetNull)
  product Product @relation(fields: [productId], references: [id])
  uom ProductUOM @relation(fields: [uomId], references: [id])
  importedBy User? @relation("InventoryBatchImporter", fields: [importedById], references: [id], onDelete: SetNull)
  approvedBy User? @relation("InventoryBatchApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  events InventoryBatchEvent[]
  saleAllocations SaleBatchAllocation[]
  @@unique([companyId, locationId, displayBatchId, productId])
  @@index([productId, createdAt])
  @@index([companyId, locationId, productId, status, receivedAt])
}

model InventoryBatchEvent {
  id String @id
  companyId String
  inventoryBatchId String
  type String
  quantityDelta Decimal @db.Decimal(14, 4)
  beforeRemaining Decimal @db.Decimal(14, 4)
  afterRemaining Decimal @db.Decimal(14, 4)
  actorId String?
  approvedById String?
  reason String?
  referenceType String
  referenceId String
  createdAt DateTime @default(now())

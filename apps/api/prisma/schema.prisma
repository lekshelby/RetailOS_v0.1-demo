generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum SaleStatus {
  OPEN
  COMPLETED
  VOIDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  DUITNOW
  BANK_TRANSFER
  STORE_CREDIT
  OTHER
}

enum ReturnStatus {
  DRAFT
  COMPLETED
  VOIDED
}

enum ReturnType {
  REFUND
  DISPOSE
  EXCHANGE
}

enum SyncStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

enum SyncDirection {
  INBOUND
  OUTBOUND
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum DiscountScope {
  LINE
  SALE
}

enum EInvoiceRequestStatus {
  PENDING
  PROCESSING
  VALIDATED
  REJECTED
}

enum CashMovementType {
  CASH_IN
  CASH_OUT
}

model Company {
  id String @id @default(cuid())
  name String
  code String @unique
  currency String @default("MYR")
  timezone String @default("Asia/Kuala_Lumpur")
  legalName String?
  registrationNo String?
  tin String?
  brnNew String?
  brnOld String?
  address String?
  officePhone String?
  phone String?
  email String?
  receiptFooter String?
  receiptPaperWidthMm Int @default(80)
  printerConnectionMethod String @default("LAN_ESC_POS")
  bukkuProductVersion String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  locations Location[]
  users User[]
  products Product[]
  customers Customer[]
  priceLevels PriceLevel[]
  sales Sale[]
  returns Return[]
  eInvoiceRequests EInvoiceRequest[]
  storeCredits StoreCredit[]
  syncJobs SyncJob[]
  auditLogs AuditLog[]
  references ExternalReference[]
  roles Role[]
}

model Location {
  id String @id @default(cuid())
  companyId String
  name String
  code String
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  registers Register[]
  stockSnapshots StockSnapshot[]
  shifts Shift[]
  sales Sale[]
  receiptCounters ReceiptCounter[]
  @@unique([companyId, code])
}

model Register {
  id String @id @default(cuid())
  locationId String
  name String
  code String
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  sales Sale[]
  shifts Shift[]
  @@unique([locationId, code])
}

model Role {
  id String @id @default(cuid())
  companyId String
  name String
  permissions Json
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users User[]
  @@unique([companyId, name])
}

model User {
  id String @id @default(cuid())
  companyId String
  roleId String
  name String
  email String
  pinHash String?
  status UserStatus @default(ACTIVE)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])
  sales Sale[]
  shifts Shift[]
  auditLogs AuditLog[]
  approvals DiscountOverride[] @relation("DiscountApprover")
  @@unique([companyId, email])
}

model Product {
  id String @id @default(cuid())
  companyId String
  sku String
  name String
  description String?
  supplierDescription String?
  supplierName String?
  lastPurchasedAt DateTime?
  nominalLengthMeters Decimal? @db.Decimal(8, 3)
  basePurchaseCost Decimal? @db.Decimal(14, 2)
  category String?
  classificationCode String?
  bukkuType String?
  bukkuCatalogHash String?
  active Boolean @default(true)
  trackStock Boolean @default(true)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uoms ProductUOM[]
  barcodes ProductBarcode[]
  prices ProductPrice[]
  purchasePrices ProductPurchasePrice[]
  saleItems SaleItem[]
  returnItems ReturnItem[]
  stockSnapshots StockSnapshot[]
  @@unique([companyId, sku])
  @@index([companyId, name])
}

model ProductUOM {
  id String @id @default(cuid())
  productId String
  code String
  name String
  conversionFactor Decimal @db.Decimal(12, 4)
  isBase Boolean @default(false)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  barcodes ProductBarcode[]
  prices ProductPrice[]
  purchasePrices ProductPurchasePrice[]
  saleItems SaleItem[]
  returnItems ReturnItem[]
  @@unique([productId, code])
}

model ProductBarcode {
  id String @id @default(cuid())
  productId String
  barcode String @unique
  uomId String?
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  uom ProductUOM? @relation(fields: [uomId], references: [id])
}

model PriceLevel {
  id String @id @default(cuid())
  companyId String
  name String
  code String
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  prices ProductPrice[]
  sales Sale[]
  @@unique([companyId, code])
}

model ProductPrice {
  id String @id @default(cuid())
  productId String
  priceLevelId String
  uomId String
  amount Decimal @db.Decimal(14, 2)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceLevel PriceLevel @relation(fields: [priceLevelId], references: [id], onDelete: Cascade)
  uom ProductUOM @relation(fields: [uomId], references: [id])
  @@unique([productId, priceLevelId, uomId])
}

model ProductPurchasePrice {
  id String @id @default(cuid())
  productId String
  uomId String
  amount Decimal @db.Decimal(14, 2)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  uom ProductUOM @relation(fields: [uomId], references: [id], onDelete: Cascade)
  @@unique([productId, uomId])
}

model Customer {
  id String @id @default(cuid())
  companyId String
  contactCode String?
  entityType String @default("MALAYSIAN_COMPANY")
  contactTypes String[] @default(["CUSTOMER"])
  name String
  registrationNoType String?
  registrationNo String?
  oldRegistrationNo String?
  phone String?
  email String?
  taxId String?
  sstRegistrationNo String?
  organization String?
  address String?
  city String?
  state String?
  postcode String?
  countryCode String? @default("MY")
  remarks String?
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sales Sale[]
  returns Return[]
  storeCredits StoreCredit[]
  @@unique([companyId, contactCode])
  @@index([companyId, name])
}

model Sale {
  id String @id @default(cuid())
  companyId String
  locationId String
  registerId String
  cashierId String
  customerId String?
  priceLevelId String
  shiftId String?
  receiptNo String
  status SaleStatus @default(OPEN)
  subtotal Decimal @db.Decimal(14, 2)
  discountTotal Decimal @db.Decimal(14, 2)
  taxTotal Decimal @db.Decimal(14, 2)
  grandTotal Decimal @db.Decimal(14, 2)
  offlineId String?
    deviceId String?
    completedAt DateTime?
  printedAt DateTime?
  eInvoiceRequestToken String? @unique
    createdAt DateTime @default(now())
  company Company @relation(fields: [companyId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  register Register @relation(fields: [registerId], references: [id])
  cashier User @relation(fields: [cashierId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  priceLevel PriceLevel @relation(fields: [priceLevelId], references: [id])
  shift Shift? @relation(fields: [shiftId], references: [id])
  items SaleItem[]
  payments Payment[]
  discounts DiscountOverride[]
  returns Return[]
  exchangeReplacement Return? @relation("ExchangeReplacementSale")
  eInvoiceRequests EInvoiceRequest[]
  @@unique([companyId, receiptNo])
  @@unique([companyId, offlineId])
  @@index([companyId, completedAt])
}

model EInvoiceRequest {
  id String @id @default(cuid())
  saleId String
  companyId String
  token String @unique
  status EInvoiceRequestStatus @default(PENDING)
  entityType String
  name String
  registrationNoType String?
  registrationNo String?
  tin String?
  phone String?
  email String?
  address String?
  submittedAt DateTime @default(now())
  processedAt DateTime?
  notes String?
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@index([companyId, status, submittedAt])
}

model SaleItem {
  id String @id @default(cuid())
  saleId String
  productId String
  uomId String
  description String
  quantity Decimal @db.Decimal(12, 4)
  baseQuantity Decimal @db.Decimal(14, 4)
  unitPrice Decimal @db.Decimal(14, 2)
  lineDiscount Decimal @db.Decimal(14, 2)
  taxAmount Decimal @db.Decimal(14, 2)
  lineTotal Decimal @db.Decimal(14, 2)
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  uom ProductUOM @relation(fields: [uomId], references: [id])
  discounts DiscountOverride[]
  returns ReturnItem[]
}

model Payment {
  id String @id @default(cuid())
  saleId String
  method PaymentMethod
  amount Decimal @db.Decimal(14, 2)
  tenderedAmount Decimal @db.Decimal(14, 2)
  changeAmount Decimal @default(0) @db.Decimal(14, 2)
  reference String?
  status PaymentStatus @default(COMPLETED)
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model DiscountOverride {
  id String @id @default(cuid())
  saleId String?
  saleItemId String?
  scope DiscountScope
  type DiscountType
  inputValue Decimal @db.Decimal(14, 4)
  amount Decimal @db.Decimal(14, 2)
  reason String
  approvedById String?
  sale Sale? @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleItem SaleItem? @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("DiscountApprover", fields: [approvedById], references: [id])
}

model Return {
  id String @id @default(cuid())
  saleId String
  companyId String
  customerId String?
  shiftId String?
  replacementSaleId String? @unique
  status ReturnStatus @default(DRAFT)
  type ReturnType @default(REFUND)
  reason String?
  total Decimal @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  sale Sale @relation(fields: [saleId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  shift Shift? @relation(fields: [shiftId], references: [id])
  replacementSale Sale? @relation("ExchangeReplacementSale", fields: [replacementSaleId], references: [id])
  items ReturnItem[]
  payments ReturnPayment[]
  storeCredit StoreCredit?
}

model ReturnItem {
  id String @id @default(cuid())
  returnId String
  saleItemId String?
  productId String
  uomId String
  quantity Decimal @db.Decimal(12, 4)
  baseQuantity Decimal @db.Decimal(14, 4)
  amount Decimal @db.Decimal(14, 2)
  return Return @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem SaleItem? @relation(fields: [saleItemId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  uom ProductUOM @relation(fields: [uomId], references: [id])
}

model ReturnPayment {
  id String @id @default(cuid())
  returnId String
  method PaymentMethod
  amount Decimal @db.Decimal(14, 2)
  reference String?
  createdAt DateTime @default(now())
  return Return @relation(fields: [returnId], references: [id], onDelete: Cascade)
}

model StoreCredit {
  id String @id @default(cuid())
  companyId String
  customerId String?
  returnId String @unique
  originalAmount Decimal @db.Decimal(14, 2)
  balance Decimal @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  return Return @relation(fields: [returnId], references: [id], onDelete: Cascade)
  @@index([companyId, balance])
}

model Shift {
  id String @id @default(cuid())
  locationId String
  registerId String
  cashierId String
  openedAt DateTime @default(now())
  closedAt DateTime?
  openingFloat Decimal @db.Decimal(14, 2)
  closingFloat Decimal? @db.Decimal(14, 2)
  location Location @relation(fields: [locationId], references: [id])
  register Register @relation(fields: [registerId], references: [id])
  cashier User @relation(fields: [cashierId], references: [id])
  movements CashMovement[]
  sales Sale[]
  processedReturns Return[]
}

model CashMovement {
  id String @id @default(cuid())
  shiftId String
  type CashMovementType
  amount Decimal @db.Decimal(14, 2)
  reason String
  createdAt DateTime @default(now())
  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
}

model StockSnapshot {
  id String @id @default(cuid())
  locationId String
  productId String
  quantity Decimal @db.Decimal(14, 4)
  capturedAt DateTime @default(now())
  location Location @relation(fields: [locationId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  @@unique([locationId, productId])
}

model ReceiptCounter {
  id String @id @default(cuid())
  locationId String
  businessDate DateTime @db.Date
  value Int @default(0)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  @@unique([locationId, businessDate])
}

model SyncJob {
  id String @id @default(cuid())
  companyId String
  provider String
  entityType String
  entityId String
  action String
  direction SyncDirection
  idempotencyKey String @unique
  payload Json?
  status SyncStatus @default(PENDING)
  cursor String?
  attempts Int @default(0)
  availableAt DateTime @default(now())
  lastError String?
  startedAt DateTime?
  finishedAt DateTime?
  createdAt DateTime @default(now())
  company Company @relation(fields: [companyId], references: [id])
  logs SyncLog[]
  @@index([provider, status, availableAt])
}

model SyncLog {
  id String @id @default(cuid())
  syncJobId String
  entityType String
  entityId String
  action String
  status String
  requestMeta Json?
  responseMeta Json?
  error String?
  createdAt DateTime @default(now())
  syncJob SyncJob @relation(fields: [syncJobId], references: [id], onDelete: Cascade)
}

model ExternalReference {
  id String @id @default(cuid())
  companyId String
  provider String
  entityType String
  localId String
  externalId String
  syncedAt DateTime @default(now())
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@unique([companyId, provider, entityType, localId])
  @@unique([companyId, provider, entityType, externalId])
}

model AuditLog {
  id String @id @default(cuid())
  companyId String
  actorId String?
  action String
  entityType String
  entityId String?
  before Json?
  after Json?
  reason String?
  metadata Json?
  createdAt DateTime @default(now())
  company Company @relation(fields: [companyId], references: [id])
  actor User? @relation(fields: [actorId], references: [id])
  @@index([companyId, entityType, entityId])
}
